# PostgreSQL Database Configuration (used by Docker Compose)
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local or Docker Database Connection String
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=school_admission;Username=postgres;Password=postgres

# Seat Hold Duration in Seconds (Default: 600s = 10 minutes)
HOLD_DURATION_SECONDS=600

# Background Service Cleanup Interval in Seconds
HOLD_CLEANUP_INTERVAL_SECONDS=10

# Frontend API Base URL (used when building or running frontend)
VITE_API_BASE_URL=http://localhost:8080
