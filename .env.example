# PostgreSQL Database Connection String
# Example for local PostgreSQL 18
DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=school_admission;Username=postgres;Password=postgres

# Hold reservation duration in seconds (default is 600 seconds = 10 minutes)
HOLD_DURATION_SECONDS=600

# Background service expiration check interval in seconds (default is 10 seconds)
HOLD_CLEANUP_INTERVAL_SECONDS=10

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development
